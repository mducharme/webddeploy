# /etc/webddeploy/env — root:ddeploy-web 0640. Read by webddeploy.service.
NODE_ENV=production
HOST=127.0.0.1
PORT=8790
# Must match WEB_HOSTNAME in ddeploy's provisioner.conf.
PUBLIC_URL=https://ddeploy.staging.example.com
DATABASE_PATH=/var/lib/webddeploy/webddeploy.sqlite
STATIC_DIR=/opt/webddeploy/client/dist

# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Authorized redirect URI: <PUBLIC_URL>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Workspace domain(s) allowed to sign in (the ID token's hd claim).
GOOGLE_ALLOWED_DOMAINS=example.com
# Who may use the UI (comma-separated). Fixed here: the UI can't change or
# remove these, so nobody can lock everyone out. Super-admins can add more
# users (any role) from the Admin > Users page.
#   super-admin: everything, plus server settings, users, global options
#   admin:       every site action (deploys, env, database, files, backups)
#   viewer:      read-only
SUPERADMIN_EMAILS=you@example.com
ADMIN_EMAILS=
VIEWER_EMAILS=

# The one command `ddeploy init-web` allows this service's user to run.
DDEPLOY_COMMAND=sudo -n /opt/ddeploy/provision.sh
# SERVER_NAME=staging-1
