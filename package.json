{
  "name": "webddeploy",
  "private": true,
  "type": "module",
  "description": "Web frontend for ddeploy",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @webddeploy/server --filter @webddeploy/client dev",
    "build": "pnpm --filter @webddeploy/client build",
    "start": "pnpm --filter @webddeploy/server start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  }
}
