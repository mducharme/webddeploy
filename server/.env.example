# Development: copy to server/.env (read by `pnpm dev`).
PORT=8790
PUBLIC_URL=http://localhost:5173
# Sign in without Google while developing (refused when NODE_ENV=production).
DEV_LOGIN_EMAIL=you@example.com
# Against ddeploy's docker test harness (ddeploy: docker/test/run.sh --keep):
DDEPLOY_COMMAND=["docker","exec","-i","ddeploytest-web-1","/opt/ddeploy/provision.sh"]
